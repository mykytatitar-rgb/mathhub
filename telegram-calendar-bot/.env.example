# Telegram: create a bot via @BotFather, paste token
TELEGRAM_BOT_TOKEN=
# Only this Telegram user id may use the bot (get it from @userinfobot)
ALLOWED_USER_ID=
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# IANA timezone
TIMEZONE=Europe/Kyiv
# Whisper model: tiny/base/small/medium (small = good for uk/ru/en mix)
WHISPER_MODEL=small
# Which calendar to write to ("primary" = main one)
GOOGLE_CALENDAR_ID=primary
