# Telegram: create a bot via @BotFather, paste token
TELEGRAM_BOT_TOKEN=
# Only this Telegram user id may use the bot (get it from @userinfobot)
ALLOWED_USER_ID=
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# IANA timezone
TIMEZONE=Europe/Kyiv
# Which calendar to write to ("primary" = main one)
GOOGLE_CALENDAR_ID=primary

# Speech-to-text: "api" (cloud, for servers) or "local" (Whisper on this machine)
STT_BACKEND=api
# api: any OpenAI-compatible transcription endpoint. Default = Groq (console.groq.com)
STT_API_KEY=
STT_API_BASE=https://api.groq.com/openai/v1
STT_API_MODEL=whisper-large-v3-turbo
# local: tiny/base/small/medium
WHISPER_MODEL=small

# On a server: paste the whole content of token.json here (one line).
# Locally you can leave it empty and keep token.json next to this file.
GOOGLE_TOKEN_JSON=
