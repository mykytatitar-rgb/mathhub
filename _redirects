# Переадресації для Cloudflare Pages.
#
# Відкритий банк задач із сайту прибрано: на сайті лише зашифровані копії
# (assets/bank, див. tools/bank_seal.js). Але Cloudflare ще тримав у кеші
# старі копії кількох файлів за колишніми адресами й віддавав їх усім —
# уже без Access. Переадресація спрацьовує раніше за будь-який файл, тож
# ці адреси ведуть на головну, навіть якщо копія десь лишилася.

/assets/data/*  /  301
/tools/*        /  301

# Службове, що кабінету не потрібне: налаштування Claude Code, скрипти
# збирання й SQL-схема бази. Секретів там немає, але й публікувати ні до чого.
/.claude/*      /  301
/supabase/*     /  301

# Код Telegram-бота живе в цьому ж репозиторії, але працює на Vercel, а не тут.
# Секретів у папці немає; просто не показуємо її на сайті.
/telegram-calendar-bot/*  /  301
