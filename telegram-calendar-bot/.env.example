# Copy to .env for local scripts; put the same values into Vercel → Settings → Environment Variables.

# Telegram: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Any random string (A-Z a-z 0-9 _ -): python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram user id (@userinfobot). Everyone else is ignored.
ALLOWED_USER_ID=
TIMEZONE=Europe/Kyiv

# Groq (free, no card): console.groq.com → API Keys. Used for speech-to-text and, by default, parsing.
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
# Empty = auto-detect (best for a uk/ru/en mix). Or force one: uk / ru / en
STT_LANGUAGE=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Who turns text into an event: groq (free) or claude (paid, better with tricky phrasing)
LLM_BACKEND=groq
# Only for LLM_BACKEND=claude: console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# One line printed by scripts/google_auth.py
GOOGLE_TOKEN_JSON=
GOOGLE_CALENDAR_ID=primary
